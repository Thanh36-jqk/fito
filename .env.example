# Chép file này thành .env.local rồi dán khoá vào. KHÔNG commit .env.local, KHÔNG gửi khoá qua chat.
# Supabase URL và publishable key (NEXT_PUBLIC_) công khai theo thiết kế, dữ liệu được RLS bảo vệ.
# Mọi khoá khác chỉ dùng ở server.

# TMDB: themoviedb.org/settings/api → "API Read Access Token" (chuỗi dài bắt đầu bằng eyJ...)
TMDB_READ_TOKEN=

# OMDb: omdbapi.com/apikey.aspx → gói FREE, khoá gửi qua email
OMDB_API_KEY=

# Trakt: trakt.tv/oauth/applications → tạo app → Client ID
TRAKT_CLIENT_ID=

# Fanart.tv: fanart.tv/get-an-api-key → personal API key
FANART_API_KEY=

# Supabase: Project Settings → API Keys → Publishable key (sb_publishable_…; anon key kiểu cũ cũng được)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# BÍ MẬT: Secret key (sb_secret_…) hoặc service_role kiểu cũ. Chỉ dùng trong scripts/ và GitHub Actions.
# TUYỆT ĐỐI không thêm tiền tố NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
